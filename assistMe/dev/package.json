{
  "name": "dev",
  "displayName": "assistMe",
  "description": "",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "dev.helloWorld",
        "title": "Hello World"
      },
      {
        "command": "todo.add",
        "title": "assistMe: Add TODO"
      },
      {
        "command": "todo.list",
        "title": "assistMe: Show TODO"
      },
      {
        "command": "showdoc",
        "title": "assistMe: Show Doc"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "assistMeContainer",
          "title": "assistMe",
          "icon": "media/assistMe.svg"
        }
      ]
    },
    "views": {
      "assistMeContainer": [
        {
          "id": "todoView",
          "name":"TODO List",
          "icon": "media/assistMe.svg"
        },
        {
          "id": "docView",
          "name": "Documentation",
          "icon": "media/assistMe.svg"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.100.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@typescript-eslint/eslint-plugin": "^8.31.1",
    "@typescript-eslint/parser": "^8.31.1",
    "eslint": "^9.25.1",
    "typescript": "^5.8.3",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.5.2"
  }
}
